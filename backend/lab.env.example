# Panel 1 lab environment TEMPLATE. Copy to `lab.env.local` (gitignored) and fill in.
# Never put real values in this tracked file.
#
# The backend loads this file (as lab.env.local) at startup via app/config.py; only
# TRAINER_LAB_* keys are imported and real environment variables take precedence.

# Hack Mode live MQTT attack path against the real training broker.
TRAINER_HACK_LIVE_MQTT=

# Panel 1 Mosquitto accounts (authenticated).
#  guest     (unauthorized identity) -> Hack Mode forged-command attack
#  validator (authorized identity)   -> Build Mode remediation validation
TRAINER_LAB_PANEL1_GUEST_PASSWORD=
TRAINER_LAB_PANEL1_VALIDATOR_PASSWORD=

# The per-command authorization token the validator's authorized probes carry.
# Required by Build Mode validation; without it the check reports
# "this deployment has not provisioned the training-lab credentials" and stops.
TRAINER_LAB_PANEL1_COMMAND_TOKEN=
